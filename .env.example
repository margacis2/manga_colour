# Environment Configuration for Blue Box Color Studio

# Application Mode: local | production | hybrid
APP_MODE=local
DEBUG=true
SECRET_KEY=dev-secret-change-in-production-blue-box-studio-secret-key-32chars
API_PORT=8000
API_HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database: SQLite for local, PostgreSQL for production
# Local SQLite default:
DATABASE_URL=sqlite:///./data/bluebox.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bluebox_db

# Storage configuration
# storage_type: local | s3
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT=./storage

# S3 / Cloudflare R2 (optional in production)
# S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=bluebox-manga-storage
# S3_REGION=auto

# Processing / Worker settings
DEFAULT_PROVIDER=local_gpu
FALLBACK_TO_CPU=true
MAX_VRAM_GB=4.0
MAX_BATCH_SIZE=4
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_SECONDS=2.0

# Remote Worker Security (when online server connects to local machine)
# WORKER_SECRET_TOKEN=
